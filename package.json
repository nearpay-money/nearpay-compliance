{
  "name": "nearpay-compliance",
  "version": "0.1.0",
  "private": true,
  "description": "Address screening (local OFAC list + blocklist), geo policy, KYB cases with the manual decision, compliance cases and reviews, account suspension.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.11.0 <23"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "coverage": "vitest run --project unit --coverage",
    "verify": "pnpm typecheck && pnpm lint && pnpm coverage && pnpm test:integration && pnpm build"
  },
  "dependencies": {
    "@nearpay-internal/auth": "0.6.0",
    "@nearpay-internal/bus": "0.6.0",
    "@nearpay-internal/chains": "0.4.0",
    "@nearpay-internal/db": "0.6.0",
    "@nearpay-internal/http": "0.6.0",
    "@nearpay-internal/ids": "0.5.0",
    "@nearpay-internal/service": "0.6.0",
    "@nearpay-internal/spec": "0.2.1",
    "@nearpay-money/spec": "0.5.0",
    "prom-client": "15.1.3",
    "sax": "1.6.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@nearpay-internal/testing": "0.6.0",
    "@types/node": "22.20.5",
    "@types/sax": "1.2.7",
    "@vitest/coverage-v8": "2.1.9",
    "fast-check": "4.10.2",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  },
  "pnpm": {
    "overrides": {
      "@nearpay-money/spec": "0.5.0",
      "@nearpay/spec": "npm:@nearpay-money/spec@0.5.0",
      "@nearpay-internal/spec": "0.2.1"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "cpu-features",
      "ssh2",
      "protobufjs"
    ]
  }
}
